<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: solid brand color without icon; the Flutter splash then fades in
         the gradient with the app name. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_blue_violet</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_no_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
