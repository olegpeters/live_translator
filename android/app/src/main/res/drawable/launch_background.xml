<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Flutter draws (Android < 12): brand gradient like the store icon.
     The Flutter splash (SplashOverlay) continues it with the app name in the middle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/brand_cyan"
                android:centerColor="@color/brand_blue_violet"
                android:endColor="@color/brand_magenta"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
